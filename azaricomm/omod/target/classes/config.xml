<?xml version="1.0" encoding="UTF-8"?>

<module configVersion="1.2">
	
	<!-- Base Module Properties -->
	<id>azaricomm</id>
	<name>Azari Comm</name>
	<version>1.0.0-SNAPSHOT</version>
	<package>org.openmrs.module.azaricomm</package>
	<author>jarivankaam</author>
	<description>
			no description
	</description>

	<activator>org.openmrs.module.azaricomm.AzariCommActivator</activator>
	
	<!-- <updateURL>https://modules.openmrs.org/modules/download/azaricomm/update.rdf</updateURL> -->
	<!-- /Base Module Properties -->
	
	<require_version>2.0.0</require_version>

	<require_modules>
		<require_module version="${appframeworkVersion}">
			org.openmrs.module.appframework
		</require_module>
		<require_module version="${uiframeworkVersion}">
			org.openmrs.module.uiframework
		</require_module>
		<require_module version="${uicommonsModuleVersion}">
			org.openmrs.module.uicommons
		</require_module>
		<require_module version="${appuiVersion}">
			org.openmrs.module.appui
		</require_module>
	</require_modules>
	
	<!-- Extensions -->
	<extension>
		<point>org.openmrs.admin.list</point>
		<class>org.openmrs.module.azaricomm.extension.html.AdminList</class>
	</extension>

	<aware_of_modules>
		<aware_of_module>org.openmrs.module.legacyui</aware_of_module>
	</aware_of_modules>
	
	
	<!-- AOP
	<advice>
		<point>org.openmrs.api.FormService</point>
		<class>org.openmrs.module.azaricomm.advice.DuplicateFormAdvisor</class>
	</advice>
	 /AOP -->
	
	
	<!-- Required Privileges 
	<privilege>
		<name>Form Entry</name>
		<description>Allows user to access Form Entry pages/functions</description>
	</privilege>
	 /Required Privileges -->


	<!-- Required Global Properties 
	<globalProperty>
		<property>azaricomm.someProperty</property>
		<defaultValue></defaultValue>
		<description>
			A description of the global property goes here.  The description
			should explain enough for administrators to understand the purpose
			and possible values for the global property.
		</description>
	</globalProperty>
	/Required Global Properties -->

	<globalProperty>
		<property>azaricomm.rabbitmq.host</property>
		<defaultValue>localhost</defaultValue>
		<description>RabbitMQ server hostname</description>
	</globalProperty>
	<globalProperty>
		<property>azaricomm.rabbitmq.port</property>
		<defaultValue>5672</defaultValue>
		<description>RabbitMQ server port</description>
	</globalProperty>
	<globalProperty>
		<property>azaricomm.rabbitmq.username</property>
		<defaultValue>guest</defaultValue>
		<description>RabbitMQ username</description>
	</globalProperty>
	<globalProperty>
		<property>azaricomm.rabbitmq.password</property>
		<defaultValue>guest</defaultValue>
		<description>RabbitMQ password</description>
	</globalProperty>
	<globalProperty>
		<property>azaricomm.rabbitmq.exchange</property>
		<defaultValue>openmrs.events</defaultValue>
		<description>RabbitMQ exchange name</description>
	</globalProperty>
	<globalProperty>
		<property>azaricomm.organization.id</property>
		<defaultValue></defaultValue>
		<description>Organization ID for this OpenMRS instance (used in notifications)</description>
	</globalProperty>
	<globalProperty>
		<property>azaricomm.organization.timezone</property>
		<defaultValue>UTC</defaultValue>
		<description>Timezone for this organization (e.g. Europe/Amsterdam)</description>
	</globalProperty>

